    sizing_mode: fixed
    thread_safe_setters: ''
    title: Practica 1
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

