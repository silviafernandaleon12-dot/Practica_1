- name: epy_block_0
  id: epy_block
  parameters:
    N: '4'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, N=4):  # <--- Asigna un n\xFAmero (ej. 4), NUNCA None\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Promedios_de_tiempos',\n\
      \            in_sig=[np.float32],\n            out_sig=[np.float32, np.float32,\
      \ np.float32, np.float32, np.float32]\n        )\n        self.N = N\n     \
      \   self.buffer = []\n        \n        self.val_media = 0.0\n        self.val_m_cuad\
      \ = 0.0\n        self.val_rms = 0.0\n        self.val_potencia = 0.0\n     \
      \   self.val_std = 0.0\n\n    def work(self, input_items, output_items):\n \
      \       in0 = input_items[0]\n        out_media, out_m_cuad, out_rms, out_potencia,\
      \ out_std = output_items\n\n        for sample in in0:\n            self.buffer.append(sample)\n\
      \            \n            if len(self.buffer) >= self.N:\n                arr\
      \ = np.array(self.buffer)\n                \n                self.val_media\
      \ = float(np.mean(arr))\n                self.val_m_cuad = float(np.mean(arr**2))\n\
      \                self.val_rms = float(np.sqrt(self.val_m_cuad))\n          \
      \      self.val_potencia = float(self.val_m_cuad)\n                self.val_std\
      \ = float(np.std(arr))\n                \n                self.buffer = []\n\
      \n        out_media[:] = self.val_media\n        out_m_cuad[:] = self.val_m_cuad\n\
      \        out_rms[:] = self.val_rms\n        out_potencia[:] = self.val_potencia\n\
      \        out_std[:] = self.val_std\n\n        return len(in0)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Promedios_de_tiempos', 'blk', [('N', '4')], [('0', 'float', 1)],
      [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1),
      ('4', 'float', 1)], '', ['N'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 312.0]
    rotation: 0
    state: enabled
